# Security headers for static assets. Pages Functions do NOT inherit these —
# see functions/_lib/security.js and functions/api/_middleware.js.
#
# 2026-09-05: live apex + jasonwpalmer-com.pages.dev were sending
# Access-Control-Allow-Origin: * on static responses (not from this file —
# likely a Pages/dashboard layer). Detach it here. Do not re-add wildcard CORS.
#
# 2026-09-03, found live with a headless browser on the real apex: GA4 and
# Cloudflare Insights were being BLOCKED by this CSP and had been since GA4
# shipped on 2026-08-31. `googletagmanager.com` was never in `script-src` — a
# `git log -S` over this file returns nothing. The tag was in the HTML, which is
# what "live-verified" checked, but the browser refused to execute it, so the
# GA4 property has been recording nothing. Present in the markup is not the same
# as running. Hosts added below; verify by loading the page in a real browser
# and reading the console, not by grepping the HTML for the tag.
#
# 2026-09-04: the 09-03 script-src fix is live — a real browser load of /,
# /blog/, and /privacy/ each fires gtag page_view to G-Z05EBSHWWC and Google
# answers 204. HQ Data API collecting=false is that report lag / admin, not a
# missing tag. Remaining CSP hole vs the working wafergraph allowlist: img-src
# had no GA hosts (Safari's pixel fallback) and connect-src only listed www +
# region1 (other regions + analytics.google.com + gtag config XHR). Wildcards
# below match wafergraph; do not treat a 204 from one Chrome region as "CSP is
# done".
#
# 2026-09-05: unused third-party hosts removed from CSP (beehiiv — mailing list
# is self-hosted; visit-log.jwpalm99.workers.dev — transition window closed,
# that host leaked a personal handle in every response). Beacon is
# visit.ironstrikeai.com only.
/*
  ! Access-Control-Allow-Origin
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://visit.ironstrikeai.com https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://jasonwpalmer.com https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' https://api.web3forms.com https://visit.ironstrikeai.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://cloudflareinsights.com; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

# Production + preview pages.dev aliases — do not index. Write APIs are also
# refused on these hosts by functions/api/_middleware.js.
https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow
  ! Access-Control-Allow-Origin

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow
  ! Access-Control-Allow-Origin
