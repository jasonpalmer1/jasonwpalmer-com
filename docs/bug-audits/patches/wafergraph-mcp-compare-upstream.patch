+export type ToolHandlerResult = ReturnType<typeof jsonResult> | ReturnType<typeof errorResult>;
+
+/** Map UpstreamFetchError (and only that) to a structured tool errorResult. */
+export function upstreamErrorResult(err: UpstreamFetchError) {
+  return errorResult(err.message, {
+    code: err.code,
+    filename: err.filename,
+    ...(err.status !== undefined ? { status: err.status } : {}),
+    hint: "Live companies/deals fetch from wafergraph.com failed. Retry shortly; taxonomy tools that only need the vendored snapshot are unaffected.",
+  });
+}
+
+/**
+ * Run a tool body and turn upstream data-fetch failures into errorResult
+ * instead of an unhandled throw. Re-throws anything that is not UpstreamFetchError.
+ */
+export async function withUpstreamGuard(
+  fn: () => Promise<ToolHandlerResult>,
+): Promise<ToolHandlerResult> {
+  try {
+    return await fn();
+  } catch (err) {
+    if (err instanceof UpstreamFetchError) return upstreamErrorResult(err);
+    throw err;
+  }
+}
